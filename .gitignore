# Root ignores
# Claude AI settings
.claude/

# Node dependencies
backend/node_modules
frontend/node_modules
**/node_modules

# Build outputs
frontend/dist

# Windows reserved device names
**/nul
nul

# Environment variables
.env
backend/.env
frontend/.env

# SQLite databases & backups
# 注释掉以下行，允许 dev.db 被包含在发布包中
# backend/prisma/*.db
backend/prisma/*.db-journal
backend/prisma/*.db-wal
backend/prisma/*backup*

# Logs
*.log
backend/logs
frontend/logs

# Editor configs
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store

# Excel temporary files
frontend/*.xlsx

# Prisma generated (if any)
backend/src/generated/prisma
